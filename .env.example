# Скопируйте этот файл в .env и заполните собственными значениями перед `docker compose up`.
# .env не должен коммититься в git (см. .gitignore).

POSTGRES_DB=infra_registry
POSTGRES_USER=infra
# Обязательно задайте свой пароль — без него docker compose откажется стартовать.
# Допустимы любые символы (@ : / % …). Если в пароле есть `#`, `$` или пробел, возьмите значение в одинарные
# кавычки, как требует формат .env: POSTGRES_PASSWORD='p@ss#word$1'
POSTGRES_PASSWORD=change_me

# Необязательно: готовый адрес БД (внешний сервер PostgreSQL, нестандартные параметры). Имеет приоритет над
# POSTGRES_*. Пароль в адресе нужно экранировать самому («@» → %40, «%» → %25).
# DATABASE_URL=postgresql+psycopg://user:pass@db.example.local:5432/infra_registry

# Список разрешённых origin'ов для CORS через запятую. По умолчанию пусто — CORS выключен (интерфейс
# отдаётся с того же адреса, что и API). Нужен только для отдельного фронтенда, например:
# INFRA_REGISTRY_CORS_ORIGINS=http://localhost:5173,https://infra.example.local
INFRA_REGISTRY_CORS_ORIGINS=

# Допустимые значения заголовка Host (защита от DNS-rebinding). '*' — не проверять; в docker-compose.yml
# так по умолчанию. Для боевого сервера перечислите реальные имена и адреса через запятую:
# INFRA_REGISTRY_ALLOWED_HOSTS=reestr.corp.local,10.0.0.5
INFRA_REGISTRY_ALLOWED_HOSTS=*

# Адреса и подсети клиентов, которым разрешено подключаться (через запятую). Пусто — без ограничений по
# адресу (так в Docker по умолчанию). Остальные адреса получают 403. Пример:
# INFRA_REGISTRY_ALLOWED_CLIENTS=192.168.1.15,10.0.5.0/24
# Для EXE-версии переменная не нужна: её задаёт файл настроек infra_registry.toml рядом с EXE.
INFRA_REGISTRY_ALLOWED_CLIENTS=

# Токен первичной настройки аутентификации (по умолчанию аутентификация выключена). Без токена создавать
# пользователей и включать аутентификацию можно только с localhost; в Docker адрес клиента — не localhost,
# поэтому задайте длинную случайную строку и введите её в «Настройки → Аутентификация».
# Пример: INFRA_REGISTRY_SETUP_TOKEN=$(openssl rand -hex 24)
INFRA_REGISTRY_SETUP_TOKEN=

# Сколько дней хранятся сформированные отчёты (файлы удаляются при формировании следующего отчёта).
# 0 — не удалять никогда.
INFRA_REGISTRY_REPORT_RETENTION_DAYS=30
