# Скопируйте этот файл в .env и заполните собственными значениями перед `docker compose up`.
# .env не должен коммититься в git (см. .gitignore).

POSTGRES_DB=infra_registry
POSTGRES_USER=infra
# Обязательно задайте свой пароль — без него docker compose откажется стартовать.
POSTGRES_PASSWORD=change_me

# Список разрешённых origin'ов для CORS через запятую, например:
# INFRA_REGISTRY_CORS_ORIGINS=http://localhost:5173,https://infra.example.local
# По умолчанию '*' — подходит для локальной сети/однопользовательского режима.
INFRA_REGISTRY_CORS_ORIGINS=*

# Кнопка "Заполнить тестовыми данными" на Dashboard. Для серверного развёртывания,
# доступного нескольким сотрудникам, можно отключить (0).
INFRA_REGISTRY_ENABLE_TEST_DATA=1
