# Скопируйте этот файл в .env и заполните собственными значениями перед `docker compose up`.
# .env не должен коммититься в git (см. .gitignore).

POSTGRES_DB=infra_registry
POSTGRES_USER=infra
# Обязательно задайте свой пароль — без него docker compose откажется стартовать.
# Допустимы любые символы (@ : / % …). Если в пароле есть `#`, `$` или пробел, возьмите значение в одинарные
# кавычки, как требует формат .env: POSTGRES_PASSWORD='p@ss#word$1'
POSTGRES_PASSWORD=change_me

# Необязательно: готовый адрес БД (внешний сервер PostgreSQL, нестандартные параметры). Имеет приоритет над
# POSTGRES_*. Пароль в адресе нужно экранировать самому («@» → %40, «%» → %25).
# DATABASE_URL=postgresql+psycopg://user:pass@db.example.local:5432/infra_registry

# Список разрешённых origin'ов для CORS через запятую. По умолчанию пусто — CORS выключен (интерфейс
# отдаётся с того же адреса, что и API). Нужен только для отдельного фронтенда (в том числе dev-сервера Vite через
# его прокси) или реестра за обратным прокси, который подменяет Host: перечисленные origin'ы могут и менять данные,
# остальные получают 403 CROSS_ORIGIN_BLOCKED на POST/PUT/PATCH/DELETE. Например:
# INFRA_REGISTRY_CORS_ORIGINS=http://localhost:5173,https://infra.example.local
INFRA_REGISTRY_CORS_ORIGINS=

# Допустимые ИМЕНА в заголовке Host (защита от DNS-rebinding). Без этой переменной compose принимает только localhost и 127.0.0.1;
# доступ по IP-адресу сервера (http://10.0.0.5:8000) работает без настройки (см. INFRA_REGISTRY_ACCEPT_IP_HOSTS ниже).
# Если сервер открывают по имени, перечислите его вместе с локальными, например:
# INFRA_REGISTRY_ALLOWED_HOSTS=localhost,127.0.0.1,reestr.corp.local
# Не ставьте '*': проверка Host отключится целиком, и при выключенной аутентификации реестр станет доступен чужим веб-страницам.
# INFRA_REGISTRY_ALLOWED_HOSTS=localhost,127.0.0.1

# Принимать Host в виде IP-адреса независимо от списка выше. По умолчанию в compose включено (true); поставьте false, чтобы
# принимать только перечисленные имена и адреса.
# INFRA_REGISTRY_ACCEPT_IP_HOSTS=true

# Адреса и подсети клиентов, которым разрешено подключаться (через запятую). Пусто — без ограничений по
# адресу (так в Docker по умолчанию). Остальные адреса получают 403. Пример:
# INFRA_REGISTRY_ALLOWED_CLIENTS=192.168.1.15,10.0.5.0/24
# Для EXE-версии переменная не нужна: её задаёт файл настроек infra_registry.toml рядом с EXE.
INFRA_REGISTRY_ALLOWED_CLIENTS=

# ОБЯЗАТЕЛЬНО: токен первичной настройки аутентификации (без него docker compose откажется стартовать).
# По умолчанию аутентификация выключена, и реестр открыт всем, кто достаёт до порта. Создавать пользователей и
# включать аутентификацию можно только с localhost или по этому токену; в Docker адрес клиента — не localhost,
# поэтому введите токен в «Настройки → Аутентификация». ЗАМЕНИТЕ значение ниже на свою длинную случайную строку:
#   openssl rand -hex 24
# Если оставить заглушку или взять токен короче 16 символов, приложение запустится и при каждом старте напишет в журнал
# предупреждение (как и для пароля БД из заглушки или короче 8 символов), но такой токен НЕ ПРИНИМАЕТСЯ: он приравнен к
# незаданному, и первичная настройка аутентификации доступна только прямым соединением с localhost. В Docker прямого
# localhost нет, поэтому с заглушкой включить аутентификацию нельзя, пока токен не заменён.
INFRA_REGISTRY_SETUP_TOKEN=change_me_long_random_string

# Адреса обратных прокси (через запятую; допустимы подсети), которым uvicorn доверяет при определении адреса клиента по
# X-Forwarded-For. Если приложение стоит за прокси, ЗАДАЙТЕ его адрес: иначе у всех клиентов будет адрес прокси — троттлинг
# входа (в том числе для настоящего администратора) станет общим, «знакомым» окажется любой адрес, а в журнале аудита и списке
# сессий останется адрес прокси. Если заголовок X-Forwarded-For придёт с адреса вне списка, сервер один раз за запуск напишет
# предупреждение в журнал. `*` — только если порт доступен одному прокси (иначе адрес клиента можно подделать).
# Без прокси оставьте значение по умолчанию (127.0.0.1) или не задавайте переменную. Пример (сеть Docker, прокси в соседнем контейнере):
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# Адрес, на котором Docker публикует порт 8000. По умолчанию 127.0.0.1 — приложение доступно только с этого
# же компьютера. Для доступа по сети поставьте 0.0.0.0, но только после включения аутентификации (README,
# «Безопасность по умолчанию»); если сервер открывают по имени, перечислите его в INFRA_REGISTRY_ALLOWED_HOSTS.
# INFRA_REGISTRY_BIND=0.0.0.0

# Сколько дней хранятся сформированные отчёты (файлы удаляются при формировании следующего отчёта).
# 0 — не удалять никогда.
INFRA_REGISTRY_REPORT_RETENTION_DAYS=30

# Сколько файлов отчётов остаётся в каталоге: при формировании нового самые старые сверх лимита удаляются независимо
# от возраста (отчёт может сформировать роль viewer — без квоты цикл запросов заполнил бы диск). 0 — без ограничения.
INFRA_REGISTRY_REPORT_MAX_FILES=200

# Сколько дней хранятся записи журнала аудита (записи старше удаляются пакетами, не чаще раза в сутки; факт очистки пишется в сам журнал).
# Перед удалением записи сохраняются в файл reports/audit/Архив_журнала_аудита_*.csv (приложение этот каталог само не очищает); не удалось
# сохранить архив — записи не удаляются.
# 0 — не удалять никогда (по умолчанию: журнал нельзя терять молча). Срок, сохранённый администратором в форме «Настройки аудита»
# (экран «Журнал аудита» и «Настройки»), важнее этой переменной; до первого сохранения формы действует она. Не больше 3650: большее значение — ошибка запуска с именем переменной.
# INFRA_REGISTRY_AUDIT_RETENTION_DAYS=0

# Наибольший размер тела запроса к API, байт (по умолчанию 2 МБ = 2097152): запрос больше получает ответ 413 и не разбирается.
# Без предела тело любого размера читалось бы в память целиком. Все тела приложения — JSON, обычные запросы занимают единицы
# килобайт. Если легитимный сценарий упирается в предел, поднимите значение; 0 — проверка выключена (нужна защита на прокси).
# INFRA_REGISTRY_MAX_REQUEST_BODY_BYTES=2097152

# Интерактивная документация API (/docs, /redoc, /openapi.json) выключена (404). Для разработки поставьте 1: страницы открыты
# без входа и подгружают скрипты с внешнего CDN. На рабочем сервере не включайте.
# INFRA_REGISTRY_ENABLE_DOCS=1

# --- Сессии и блокировка входа (действуют, когда аутентификация включена; значения по умолчанию указаны в строках) ---
# Через сколько часов сессия истекает.
# INFRA_REGISTRY_SESSION_TTL_HOURS=12
# После скольких неверных паролей подряд учётная запись блокируется (не меньше 1) и на сколько минут.
# INFRA_REGISTRY_AUTH_MAX_ATTEMPTS=10
# INFRA_REGISTRY_AUTH_LOCKOUT_MINUTES=15
# Наименьшая допустимая длина пароля (не меньше 1; проверки «буквы и цифры» остаются).
# INFRA_REGISTRY_AUTH_MIN_PASSWORD_LENGTH=8
# Блокировка отклоняет вход только с «незнакомых» адресов: «знакомым» считается адрес, с которого пользователь входил за последние N дней.
# За обратным прокси сначала задайте FORWARDED_ALLOW_IPS. 0 в BYPASS возвращает блокировку для всех адресов.
# INFRA_REGISTRY_AUTH_KNOWN_CLIENT_DAYS=30
# INFRA_REGISTRY_AUTH_LOCKOUT_KNOWN_CLIENT_BYPASS=1

# --- Пул соединений PostgreSQL (по умолчанию значения SQLAlchemy: 5 / 10 / 30 с; не выше max_connections сервера БД) ---
# INFRA_REGISTRY_DB_POOL_SIZE=5
# INFRA_REGISTRY_DB_MAX_OVERFLOW=10
# INFRA_REGISTRY_DB_POOL_TIMEOUT=30
